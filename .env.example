# ── Supabase (packages admin) ────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard. Without these the site shows
# the packages in data/tours.json and the admin can't sign in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Contact & booking forms (Resend, https://resend.com) ─────────────────────
# Without RESEND_API_KEY the forms show an error asking visitors to email/call instead.
RESEND_API_KEY=
# Where enquiries are delivered (comma-separated for several addresses)
CONTACT_TO_EMAIL=info@kawaiki.com
# Must be an address on a domain verified in Resend, e.g. "Kawaiki Website <web@kawaiki.com>"
CONTACT_FROM_EMAIL=Kawaiki Website <onboarding@resend.dev>
